NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 웹사이트 주소. 웹사이트 게임 페이지 편집 화면의 "웹사이트에서 보기" 링크에 쓴다. 비우면 링크를 숨긴다.
NEXT_PUBLIC_SITE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# 게임 문의 발신 계정
GMAIL_SENDER=help@theplayplus.com
# 서비스 문의(제휴·기타, game_id null) 발신 계정. 둘 다 비우면 게임 문의 계정으로 대신 보낸다
GMAIL_SERVICE_REFRESH_TOKEN=
GMAIL_SERVICE_SENDER=info@theplayplus.com
# 대화 열 우클릭 번역(DeepL). 비우면 번역 메뉴가 "설정되지 않음"을 안내한다. 무료 키는 :fx로 끝난다
DEEPL_API_KEY=
# Slack 새 문의 알림 (둘 다 비우면 알림 비활성)
SLACK_WEBHOOK_URL=
# Discord 알림 (Slack과 같은 때에 같은 내용). 비우면 건너뜀. 채널 설정 → 연동 → 웹후크에서 발급
DISCORD_WEBHOOK_URL=
INQUIRY_WEBHOOK_SECRET=
# AI 답변 추천 (OpenAI). 채팅 모델 외에 문의·운영정책 임베딩에 text-embedding-3-small도 쓴다
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
