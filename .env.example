# 게임 문의 발신 계정
GMAIL_SENDER=help@theplayplus.com
# 서비스 문의(제휴·기타, game_id null) 발신 계정. 둘 다 비우면 게임 문의 계정으로 대신 보낸다
GMAIL_SERVICE_REFRESH_TOKEN=
