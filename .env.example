NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# 게임 문의 발신 계정
GMAIL_SENDER=help@theplayplus.com
# 서비스 문의(제휴·기타, game_id null) 발신 계정. 둘 다 비우면 게임 문의 계정으로 대신 보낸다
GMAIL_SERVICE_REFRESH_TOKEN=
GMAIL_SERVICE_SENDER=info@theplayplus.com
# 대화 열 우클릭 번역(DeepL). 비우면 번역 메뉴가 "설정되지 않음"을 안내한다. 무료 키는 :fx로 끝난다
DEEPL_API_KEY=
# Slack 새 문의 알림 (둘 다 비우면 알림 비활성)
SLACK_WEBHOOK_URL=
INQUIRY_WEBHOOK_SECRET=
# 운영 시트 어시스턴트·AI 답변 추천 (OpenAI). 추천은 채팅 모델 외에 text-embedding-3-small도 쓴다
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# 구글 시트를 읽고 쓰고 구글 문서를 읽는 서비스 계정 키(JSON 한 줄). 각 시트·문서를 이 계정의 client_email에 편집자로 공유한다
GOOGLE_SERVICE_ACCOUNT_JSON=
